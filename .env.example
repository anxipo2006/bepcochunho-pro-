# Local development with Docker MySQL
DATABASE_URL="mysql://cochunho:cochunho_pass@localhost:3307/cochunho_db"

# NextAuth v5
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Compatibility for older NextAuth env naming.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Required only when creating the first admin account with db:seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-16-characters"
